// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  RESTAURANT_ADMIN
  DRIVER
  CUSTOMER
}

enum TenantType {
  MARKETPLACE
  WHITE_LABEL
}

enum OrderStatus {
  CREATED
  PENDING
  SEARCHING_DRIVER
  OFFERED_TO_DRIVER
  CONFIRMED
  PREPARING
  READY
  ASSIGNED
  PICKED_UP
  DELIVERED
  CANCELLED
  FAILED
}

enum TransactionType {
  COMMISSION
  SUBSCRIPTION_PAYMENT
  ADJUSTMENT
}

enum PlanType {
  BASIC
  PRO
  ENTERPRISE
}

enum OfferStatus {
  SENT
  REJECTED
  EXPIRED
  ACCEPTED
}

model Tenant{
  idTenant String @id @default(uuid())
  name String
  slug String?
  type TenantType
  isActive Boolean @default(true)

  allowOwnDrivers Boolean @default(false)
  commissionRate Float @default(0.10)

  users User[]
  restaurants Restaurant[]
  orders Order[]
  tenantTransactions TenantTransaction[]
  subscriptionPlan SubscriptionPlan?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model SubscriptionPlan {
  idSubscriptionPlan String @id @default(uuid())
  idTenant String @unique
  name String
  monthlyPrice Float
  commissionRate Float
  allowWhiteLabel Boolean
  allowOwnDrivers Boolean
  dispatchPriority Int @default(0)
  active Boolean @default(true)
  expiresAt DateTime
  plan PlanType

  tenant Tenant @relation(fields: [idTenant],references: [idTenant])

}

model TenantTransaction {
  idTenantTransaction String @id @default(uuid())

  idTenant String
  tenant Tenant @relation(fields: [idTenant],references: [idTenant])

  idOrder String?
  amount Float
  type TransactionType

  createdAt DateTime @default(now())

  @@index([idTenant])
}

model User {
  idUser  String @id @default(uuid())
  name String
  surname String
  ci  String @unique
  email String @unique
  password String
  role Role @default(CUSTOMER)
  isActive Boolean @default(true)
  fcmToken String?

  idTenant String
  tenant Tenant @relation(fields: [idTenant],references: [idTenant])

  driverProfile DriverProfile?
  managedRestaurant Restaurant? @relation("RestaurantOwner")
  
  customerOrders Order[] @relation("CustomerOrders")
  tokens RefreshToken[]
  

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([idTenant, role])
}

model DriverProfile {
  idDriver String @id
  user  User @relation(fields: [idDriver],references: [idUser])

  isOnline Boolean @default(false)
  isAvailable Boolean @default(true)
  isShared Boolean @default(true)
  rating Float @default(5.0)
  
  acceptanceRate Float @default(1.0)
  rejectionCount Int @default(0)
  cooldownUntil DateTime?
  fcmToken String?

  vehiclePlate String?
  vehicleType String?
  
  location Unsupported("geometry(Point,4326)")?
  lastLocation DriverLocation?

  offers OrderOffer[]
  assignedOrders Order[] @relation("DriverOrders")

}

model OrderOffer {
  idOrderOffer String @id @default(uuid())
  idOrder String
  idDriver String
  status OfferStatus @default(SENT)
  createdAt DateTime @default(now())
  expiresAt DateTime

  order Order @relation(fields: [idOrder],references: [idOrder])
  driver DriverProfile @relation(fields: [idDriver],references: [idDriver])

  @@index([idOrder,status])
}

model RefreshToken {
  idRefreshToken String @id @default(uuid())
  token String
  idUser String
  user User @relation(fields: [idUser],references: [idUser],onDelete: Cascade)
  
  deviceId String
  userAgent String?
  ipAddress String?
  
  createdAt DateTime @default(now())
  expiresAt DateTime
  revoked Boolean @default(false)
}

model Restaurant {
  idRestaurant String @id @default(uuid())
  name String
  address String
  lat Float
  lng Float
  location Unsupported("geometry(Point,4326)")?

  isActive Boolean @default(true)
  idTenant String
  tenant Tenant @relation(fields: [idTenant],references: [idTenant])

  idOwner String? @unique
  owner User? @relation("RestaurantOwner",fields: [idOwner],references: [idUser])

  category Category[]
  products Product[]
  orders Order[]

  createdAt DateTime @default(now())

  @@index([idTenant])
}

model Category {
  idCategory String @id @default(uuid())
  name String
  idRestaurant String
  restaurant Restaurant @relation(fields: [idRestaurant],references: [idRestaurant])
  products Product[]
  isActive Boolean @default(true)
}

model Product {
  idProduct String @id @default(uuid())
  name String
  description String?
  price Float
  imageUrl String?
  stock Int? @default(0)
  isAvailable Boolean @default(true)

  idCategory String
  category Category @relation(fields: [idCategory],references: [idCategory])

  restaurant Restaurant @relation(fields: [idRestaurant],references: [idRestaurant])
  idRestaurant String

  orderItem OrderItem []

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  idOrder String @id @default(uuid())
  orderNumber Int @default(autoincrement())
  status OrderStatus @default(PENDING)

  idCustomer String
  customer User @relation("CustomerOrders",fields: [idCustomer], references: [idUser])
  
  idRestaurant String
  restaurant Restaurant @relation(fields: [idRestaurant],references: [idRestaurant])
  
  idDriver String?
  driver DriverProfile? @relation("DriverOrders",fields: [idDriver],references: [idDriver])
  
  subtotal Float
  deliveryFee Float @default(0)
  taxAmount Float @default(0)
  discount Float @default(0)
  total Float

  commissionAmount Float?
  driverEarning Float?
  platformEarning Float?
  
  deliveryAddress String
  deliveryLat Float
  deliveryLng Float

  offers OrderOffer[]
  items OrderItem[]

  idTenant String
  tenant Tenant @relation(fields: [idTenant],references: [idTenant])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([idTenant, status])
  @@index([idRestaurant])
  @@index([idDriver])
  @@index([status])
  @@index([idCustomer])
}

model OrderItem {
  idOrderItem String @id @default(uuid())
  idOrder String
  idProduct String
  quantity Int

  priceAtPurchase Float
  nameAtPurchase String

  order Order @relation(fields: [idOrder],references: [idOrder])
  product Product @relation(fields: [idProduct],references: [idProduct])
}

model DriverLocation {
  idDriverLocation String @id @default(uuid())
  idDriver String @unique
  driver DriverProfile @relation(fields: [idDriver],references: [idDriver])

  lat Float
  lng Float
  isOnline Boolean @default(true)

  location Unsupported("geometry(Point,4326)")

  heading Float?
  speed Float?

  isActive Boolean @default(true)
  updatedAt DateTime @updatedAt

  @@index([location],type: Gist)
}
